msgstr "Back"

#: of qteasy.datatypes.find_history_data:29
msgid ""
"* **data_id** (*list[str]*) -- 当 as_data_frame 为 False 时，匹配到的数据类型的 data_id "
"列表，可以用于 qt.get_history_data() 下载数据 * *pandas.DataFrame* -- 当 as_data_frame 为"
" True 时，返回一个 DataFrame，每一行对应一个匹配到的数据类型，   至少包含下列列：       - name:        "
"数据类型名称       - description: 数据类型中文描述       - freq:        频率       - "
"asset_type:  资产类型       - table_name:  底层数据表名称       - column:      对应的数据字段名"
"       - kind:        消费形状（history / reference / static）       - usable_in:"
"   可用性标记规范串       - recommended_api: 推荐入口（get_history_data / "
"get_reference_data /         get_static_data / none）"
msgstr ""
"* **data_id** (*list[str]*) -- When as_data_frame is False, the data_id list"
" of the matched data type can be used to download data with "
"qt.get_history_data() * *pandas.DataFrame* -- When as_data_frame is True, a "
"DataFrame is returned. Each row corresponds to a matched data type and "
"contains at least the following columns: - name: data type name - "
"description: Chinese description of the data type - freq: frequency - "
"asset_type: asset type - table_name: underlying data table name - column: "
"corresponding data field name - kind: consumption shape (history / reference"
" / static) - usable_in: availability mark specification string - "
"recommended_api: recommended entry (get_history_data / get_reference_data / "
"get_static_data / none)"

#: of qteasy.datatypes.find_history_data:29
msgid ""
"**data_id** (*list[str]*) -- 当 as_data_frame 为 False 时，匹配到的数据类型的 data_id "
"列表，可以用于 qt.get_history_data() 下载数据"
msgstr ""
"**data_id** (*list[str]*) -- When as_data_frame is False, the list of "
"data_id values for the matched data types; can be used to download data via "
"qt.get_history_data()"

#: of qteasy.datatypes.find_history_data:30
msgid ""
"*pandas.DataFrame* -- 当 as_data_frame 为 True 时，返回一个 "
"DataFrame，每一行对应一个匹配到的数据类型， 至少包含下列列："
msgstr ""
"*pandas.DataFrame* -- When as_data_frame is True, returns a DataFrame. Each "
"row corresponds to a matched data type and contains at least the following "
"columns:"

#: of qteasy.datatypes.find_history_data:32
msgid "name:        数据类型名称"
msgstr "name:        Data type name"

#: of qteasy.datatypes.find_history_data:33
msgid "description: 数据类型中文描述"
msgstr "description: Chinese description of the data type"

#: of qteasy.datatypes.find_history_data:34
msgid "freq:        频率"
msgstr "freq:        Frequency"

#: of qteasy.datatypes.find_history_data:35
msgid "asset_type:  资产类型"
msgstr "asset_type:  Asset type"

#: of qteasy.datatypes.find_history_data:36
msgid "table_name:  底层数据表名称"
msgstr "table_name:  Underlying data table name"

#: of qteasy.datatypes.find_history_data:37
msgid "column:      对应的数据字段名"
msgstr "column:      Corresponding data field name"

#: of qteasy.datatypes.find_history_data:38
msgid "kind:        消费形状（history / reference / static）"
msgstr "kind: consumption shape (history/reference/static)"

#: of qteasy.datatypes.find_history_data:39
msgid "usable_in:   可用性标记规范串"
msgstr "usable_in: Availability tag specification string"

#: of qteasy.datatypes.find_history_data:40
msgid ""
"recommended_api: 推荐入口（get_history_data / get_reference_data / "
"get_static_data / none）"
msgstr ""
"recommended_api: recommended entry (get_history_data / get_reference_data / "
"get_static_data / none)"

