"     primary_key1:  str，数据表第一个主键名称     pk_count1:     int，数据表第一个主键记录数量"
"     pk_min1:       obj，数据表主键1起始记录     pk_max1:       obj，数据表主键2最终记录     "
"primary_key2:  str，数据表第二个主键名称     pk_count2:     int，数据表第二个主键记录     "
"pk_min2:       obj，数据表主键2起始记录     pk_max2:       obj，数据表主键2最终记录 }"
msgstr ""
"**data_struct** -- Información estructurada sobre la tabla de datos:\n"
"{\n"
"    table_name: nombre de la tabla de datos\n"
"    table_exists: bool, si la tabla de datos existe\n"
"    table_size: int/str, espacio en disco utilizado por la tabla; cuando "
"humano es Verdadero, devuelve una cadena legible por humanos\n"
"    table_rows: int/str, número de filas en la tabla; cuando humano es "
"Verdadero, devuelve una cadena legible por humanos\n"
"    clave_primaria1: cadena, nombre de la primera clave primaria\n"
"    pk_count1: int, número de registros para la primera clave primaria\n"
"    pk_min1: obj, registro inicial para la clave primaria 1\n"
"    pk_max1: obj, registro final para la clave primaria 1\n"
"    Primary_key2: str, nombre de la segunda clave primaria.\n"
"    pk_count2: int, número de registros para la segunda clave primaria\n"
"    pk_min2: obj, registro inicial para la clave primaria 2\n"
"    pk_max2: obj, registro final para la clave primaria 2\n"
"}"

